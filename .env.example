# Environment variables must be exported by your shell/deployment; no automatic dotenv loading.
ROUTING_PROVIDER=unconfigured
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
GRAPHHOPPER_API_KEY=
# Replace with actual profiles. Names below are illustrative, not built-in profiles.
GRAPHHOPPER_PROFILES_JSON='[{"name":"your-validated-distance-car-profile","roadPolicy":{"avoidTolls":false,"avoidFerries":true,"avoidUnpaved":true}}]'
# Set true only after validating distance objective, access rules and road preferences.
GRAPHHOPPER_DISTANCE_VALIDATED=false

# Alternative local routing engine (see routino/README.md).
# ROUTING_PROVIDER=routino
# ROUTINO_BINARY=/absolute/project/routino/vendor/routino-3.4.4/src/router-slim
# ROUTINO_DATABASE=/absolute/project/routino/data/israel
# ROUTINO_PROFILES=/absolute/project/routino/profiles/distance-car.xml
# ROUTINO_TRANSLATIONS=/absolute/project/routino/vendor/routino-3.4.4/xml/routino-translations.xml
